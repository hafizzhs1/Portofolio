{
  "builds": [
    { "src": "api/index.php", "use": "vercel-php@0.7.3", "config": { "includeFiles": ["**"] } },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/build/(.*)", "dest": "public/build/$1" },
    { "src": "/(.*\\.(?:css|js|png|jpg|jpeg|gif|svg|ico|webp|woff2?))", "dest": "public/$1" },
    { "src": "/(.*)", "dest": "api/index.php" }
  ]
}